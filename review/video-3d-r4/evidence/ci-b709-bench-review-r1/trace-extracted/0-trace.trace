{"type":"before","callId":"call@12","startTime":5184.305,"class":"Frame","method":"evaluateExpression","params":{"expression":"async function sourceFrameReceipts({\n  base64,\n  sourceTimes,\n  times,\n  trainingFrames,\n  crop\n}) {\n  const bytes = Uint8Array.from(atob(base64), c => c.charCodeAt(0));\n  const url = URL.createObjectURL(new Blob([bytes], {\n    type: \"video/mp4\"\n  }));\n  const video = document.createElement(\"video\");\n  video.muted = true;\n  video.playsInline = true;\n  video.preload = \"auto\";\n  const width = trainingFrames[0]?.width,\n    height = trainingFrames[0]?.height;\n  if (!width || !height || trainingFrames.some(f => f.width !== width || f.height !== height)) throw new Error(\"Training photograph geometry is absent or inconsistent.\");\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = width;\n  canvas.height = height;\n  const context = canvas.getContext(\"2d\", {\n    willReadFrequently: true\n  });\n  const hash = async blob => Array.from(new Uint8Array(await crypto.subtle.digest(\"SHA-256\", await blob.arrayBuffer())), b => b.toString(16).padStart(2, \"0\")).join(\"\");\n  const jpeg = () => new Promise(resolve => canvas.toBlob(resolve, \"image/jpeg\", 0.92));\n  const cache = new Map();\n  const capture = async index => {\n    if (cache.has(index)) return cache.get(index);\n    const time = sourceTimes[index],\n      next = sourceTimes[index + 1];\n    // Seek inside the selected source frame, rather than on a floating-point frame boundary.\n    const target = time + Math.min(0.005, (next == null ? 1 / 120 : next - time) / 4);\n    const mediaTime = await new Promise((resolve, reject) => {\n      let callback;\n      const finish = (error, value) => {\n        clearTimeout(timer);\n        if (callback !== undefined) video.cancelVideoFrameCallback(callback);\n        error ? reject(error) : resolve(value);\n      };\n      const frame = (_, metadata) => {\n        if (Math.abs(metadata.mediaTime - time) < 0.0001) finish(null, metadata.mediaTime);else callback = video.requestVideoFrameCallback(frame);\n      };\n      const timer = setTimeout(() => finish(new Error(`No presented source frame at ${time}.`)), 4000);\n      callback = video.requestVideoFrameCallback(frame);\n      video.currentTime = target;\n    });\n    context.drawImage(video, crop.sx, 0, crop.sw, video.videoHeight, 0, 0, width, height);\n    const sha256 = await hash(await jpeg()),\n      repeatedSha256 = await hash(await jpeg());\n    const result = {\n      index,\n      time,\n      mediaTime,\n      width,\n      height,\n      sha256,\n      repeatedSha256\n    };\n    cache.set(index, result);\n    return result;\n  };\n  try {\n    if (!video.requestVideoFrameCallback) throw new Error(\"Independent source-frame presentation is unavailable.\");\n    await new Promise((resolve, reject) => {\n      const timer = setTimeout(() => reject(new Error(\"Source video metadata timed out.\")), 10000);\n      video.onloadedmetadata = () => {\n        clearTimeout(timer);\n        resolve();\n      };\n      video.onerror = () => {\n        clearTimeout(timer);\n        reject(new Error(\"Source video cannot be decoded.\"));\n      };\n      video.src = url;\n    });\n    const views = [];\n    for (const time of times) {\n      const index = sourceTimes.findIndex(t => Math.abs(t - time) < 0.000001);\n      if (index < 0) throw new Error(\"The held-out time does not identify an exact source frame.\");\n      views.push(await capture(index));\n    }\n    // Match EVERY selected JPEG back to the independent decoder. This checks that a recreated\n    // JPEG has the same bytes as training, even on main's seek-only extraction path. Search near\n    // its requested/presented time first; a stale picture can require an earlier source frame.\n    const matchedTraining = [];\n    for (const training of trainingFrames) {\n      let match = [...cache.values()].find(f => f.sha256 === training.sha256);\n      if (!match) {\n        const target = training.presentedTime ?? training.requestedTime;\n        const order = sourceTimes.map((time, index) => ({\n          index,\n          distance: Math.abs(time - target)\n        })).sort((a, b) => a.distance - b.distance || a.index - b.index);\n        for (const {\n          index\n        } of order) {\n          const frame = await capture(index);\n          if (frame.sha256 === training.sha256) {\n            match = frame;\n            break;\n          }\n        }\n      }\n      if (!match) throw new Error(\"A training JPEG could not be matched to an independently presented source frame.\");\n      matchedTraining.push({\n        sha256: training.sha256,\n        repeatedSha256: match.repeatedSha256,\n        sourceIndex: match.index,\n        sourceTime: match.mediaTime\n      });\n    }\n    return {\n      method: \"Independent presented source frames, identical extraction canvas and JPEG encoder; every training JPEG matched, held-out JPEGs disjoint.\",\n      matchedTraining,\n      views,\n      decodedFrames: cache.size\n    };\n  } finally {\n    video.removeAttribute(\"src\");\n    video.load();\n    URL.revokeObjectURL(url);\n  }\n}","isFunction":true,"arg":{"value":{"o":[{"k":"base64","v":{"s":""}},{"k":"sourceTimes","v":{"a":[{"n":0},{"n":0.067},{"n":0.133},{"n":0.2},{"n":0.267},{"n":0.333},{"n":0.4},{"n":0.467},{"n":0.533},{"n":0.6},{"n":0.667},{"n":0.733},{"n":0.8},{"n":0.867},{"n":0.933},{"n":1},{"n":1.067},{"n":1.133},{"n":1.2},{"n":1.267},{"n":1.333},{"n":1.4},{"n":1.467},{"n":1.533},{"n":1.6},{"n":1.667},{"n":1.733},{"n":1.8},{"n":1.867},{"n":1.933}],"id":2}},{"k":"times","v":{"a":[{"n":0.667},{"n":1.667}],"id":3}},{"k":"trainingFrames","v":{"a":[{"o":[{"k":"time","v":{"n":0}},{"k":"requestedTime","v":{"n":0.333}},{"k":"presentedTime","v":{"n":0}},{"k":"sharpness","v":{"n":2269.0563571624393}},{"k":"blob","v":{"v":"undefined"}},{"k":"width","v":{"n":192}},{"k":"height","v":{"n":108}},{"k":"sha256","v":{"s":"