{"type":"before","callId":"pw:api@36","stepId":"pw:api@36","startTime":4946.488,"class":"Test","method":"pw:api","title":"Evaluate","params":{"expression":"async base64 => {\n    const {\n      openVideo,\n      grabFrames,\n      closeVideo\n    } = await import(\"/src/video3d/extract.js\");\n    const opened = await openVideo(new File([Uint8Array.from(atob(base64), c => c.charCodeAt(0))], \"tiny.webm\"));\n    try {\n      const picks = await grabFrames(opened, {\n        windows: [{\n          t: 0.333,\n          from: 0.333,\n          to: 0.333\n        }, {\n          t: 1.333,\n          from: 1.333,\n          to: 1.333\n        }]\n      }, {\n        side: 192,\n        tries: 1\n      });\n      return Promise.all(picks.map(async p => ({\n        ...p,\n        blob: undefined,\n        requestedTime: p.requestedTime,\n        sha256: Array.from(new Uint8Array(await crypto.subtle.digest(\"SHA-256\", await p.blob.arrayBuffer())), b => b.toString(16).padStart(2, \"0\")).join(\"\")\n      })));\n    } finally {\n      closeVideo(opened);\n    }\n  }","isFunction":"true","arg":"Object"},"stack":[{"file":"/home/runner/work/splashery/splashery/tests/cdx-v3d-bench.spec.mjs","line":546,"column":31}]}
