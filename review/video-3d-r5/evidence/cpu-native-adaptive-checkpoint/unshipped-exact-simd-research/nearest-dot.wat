;; MIT. Work-only exact uint8 SIFT distance prototype, made by Ryan with Codex (GPT-6).
(module
(memory (export "memory") 1)
(func (export "nearest") (param $pa i32) (param $pb i32) (param $nb i32) (param $out i32)
(local $best i32) (local $first i32) (local $second i32) (local $b i32) (local $ob i32) (local $sum i32)
(local $bv v128) (local $lo v128) (local $hi v128) (local $sumv v128)
(local $q0 v128)
(local $q1 v128)
(local $q2 v128)
(local $q3 v128)
(local $q4 v128)
(local $q5 v128)
(local $q6 v128)
(local $q7 v128)

(local.set $best (i32.const -1))
(local.set $first (i32.const -1))
(local.set $second (i32.const -1))
(local.set $q0 (v128.load offset=0 (local.get $pa)))
(local.set $q1 (v128.load offset=16 (local.get $pa)))
(local.set $q2 (v128.load offset=32 (local.get $pa)))
(local.set $q3 (v128.load offset=48 (local.get $pa)))
(local.set $q4 (v128.load offset=64 (local.get $pa)))
(local.set $q5 (v128.load offset=80 (local.get $pa)))
(local.set $q6 (v128.load offset=96 (local.get $pa)))
(local.set $q7 (v128.load offset=112 (local.get $pa)))

(block $targetsDone
(br_if $targetsDone (i32.eqz (local.get $nb)))
(loop $targets
(local.set $ob (i32.add (local.get $pb) (i32.shl (local.get $b) (i32.const 7))))
(local.set $sum (i32.const 0))
(block $distance
(local.set $bv (v128.load offset=0 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q0)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q0)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=16 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q1)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q1)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=32 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q2)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q2)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=48 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q3)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q3)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=64 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q4)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q4)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=80 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q5)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q5)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=96 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q6)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q6)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second)))
(local.set $bv (v128.load offset=112 (local.get $ob)))
(local.set $lo (i16x8.sub (i16x8.extend_low_i8x16_u (local.get $q7)) (i16x8.extend_low_i8x16_u (local.get $bv))))
(local.set $hi (i16x8.sub (i16x8.extend_high_i8x16_u (local.get $q7)) (i16x8.extend_high_i8x16_u (local.get $bv))))
(local.set $sumv (i32x4.add (i32x4.dot_i16x8_s (local.get $lo) (local.get $lo)) (i32x4.dot_i16x8_s (local.get $hi) (local.get $hi))))
(local.set $sum (i32.add (local.get $sum)
 (i32.add (i32.add (i32x4.extract_lane 0 (local.get $sumv)) (i32x4.extract_lane 1 (local.get $sumv)))
 (i32.add (i32x4.extract_lane 2 (local.get $sumv)) (i32x4.extract_lane 3 (local.get $sumv))))))
(br_if $distance (i32.ge_u (local.get $sum) (local.get $second))))
(if (i32.lt_u (local.get $sum) (local.get $first))
 (then (local.set $second (local.get $first)) (local.set $first (local.get $sum)) (local.set $best (local.get $b)))
 (else (if (i32.lt_u (local.get $sum) (local.get $second)) (then (local.set $second (local.get $sum))))))
(local.set $b (i32.add (local.get $b) (i32.const 1)))
(br_if $targets (i32.lt_u (local.get $b) (local.get $nb)))
))
(i32.store (local.get $out) (local.get $best))
(i32.store offset=4 (local.get $out) (local.get $first))
(i32.store offset=8 (local.get $out) (local.get $second))
))
