(module
 (memory (export "memory") 1)
 (func (export "blur") (param $data i32) (param $tmp i32) (param $kernel i32) (param $xs i32) (param $ys i32) (param $W i32) (param $H i32) (param $D i32)
 (local $x i32) (local $y i32) (local $i i32) (local $q i32)
 (local $r f64) (local $g f64) (local $b f64) (local $w f64)
;; horizontal: same summation order, Float64 sums, Float32 temporary.
 (local.set $y (i32.const 0))
 (block $ydone (loop $yloop
  (br_if $ydone (i32.ge_u (local.get $y) (local.get $H)))
  (local.set $x (i32.const 0))
  (block $xdone (loop $xloop
   (br_if $xdone (i32.ge_u (local.get $x) (local.get $W)))
   (local.set $r (f64.const 0)) (local.set $g (f64.const 0)) (local.set $b (f64.const 0))
   (local.set $i (i32.const 0))
   (block $idone (loop $iloop
    (br_if $idone (i32.ge_u (local.get $i) (local.get $D)))
    (local.set $q (i32.add (local.get $data) (i32.add (i32.mul (i32.mul (local.get $y) (local.get $W)) (i32.const 4)) (i32.load (i32.add (local.get $xs) (i32.mul (i32.add (i32.mul (local.get $x) (local.get $D)) (local.get $i)) (i32.const 4)))))))
    (local.set $w (f64.load (i32.add (local.get $kernel) (i32.mul (local.get $i) (i32.const 8)))))
    (local.set $r (f64.add (local.get $r) (f64.mul (local.get $w) (f64.convert_i32_u (i32.load8_u offset=0 (local.get $q))))))
(local.set $g (f64.add (local.get $g) (f64.mul (local.get $w) (f64.convert_i32_u (i32.load8_u offset=1 (local.get $q))))))
(local.set $b (f64.add (local.get $b) (f64.mul (local.get $w) (f64.convert_i32_u (i32.load8_u offset=2 (local.get $q))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $iloop)
   ))
   (local.set $q (i32.add (local.get $tmp) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $W)) (local.get $x)) (i32.const 12))))
   (f32.store offset=0 (local.get $q) (f32.demote_f64 (local.get $r)))
(f32.store offset=4 (local.get $q) (f32.demote_f64 (local.get $g)))
(f32.store offset=8 (local.get $q) (f32.demote_f64 (local.get $b)))
   (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xloop)
  ))
  (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $yloop)
 ))
;; vertical: same summation order, Float64 sums, Float32 temporary.
 (local.set $y (i32.const 0))
 (block $ydone (loop $yloop
  (br_if $ydone (i32.ge_u (local.get $y) (local.get $H)))
  (local.set $x (i32.const 0))
  (block $xdone (loop $xloop
   (br_if $xdone (i32.ge_u (local.get $x) (local.get $W)))
   (local.set $r (f64.const 0)) (local.set $g (f64.const 0)) (local.set $b (f64.const 0))
   (local.set $i (i32.const 0))
   (block $idone (loop $iloop
    (br_if $idone (i32.ge_u (local.get $i) (local.get $D)))
    (local.set $q (i32.add (local.get $tmp) (i32.add (i32.mul (local.get $x) (i32.const 12)) (i32.load (i32.add (local.get $ys) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $D)) (local.get $i)) (i32.const 4)))))))
    (local.set $w (f64.load (i32.add (local.get $kernel) (i32.mul (local.get $i) (i32.const 8)))))
    (local.set $r (f64.add (local.get $r) (f64.mul (local.get $w) (f64.promote_f32 (f32.load offset=0 (local.get $q))))))
(local.set $g (f64.add (local.get $g) (f64.mul (local.get $w) (f64.promote_f32 (f32.load offset=4 (local.get $q))))))
(local.set $b (f64.add (local.get $b) (f64.mul (local.get $w) (f64.promote_f32 (f32.load offset=8 (local.get $q))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $iloop)
   ))
   (local.set $q (i32.add (local.get $data) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $W)) (local.get $x)) (i32.const 4))))
   (i32.store8 offset=0 (local.get $q) (i32.trunc_f64_u (f64.nearest (f64.min (f64.const 255) (f64.max (f64.const 0) (local.get $r))))))
(i32.store8 offset=1 (local.get $q) (i32.trunc_f64_u (f64.nearest (f64.min (f64.const 255) (f64.max (f64.const 0) (local.get $g))))))
(i32.store8 offset=2 (local.get $q) (i32.trunc_f64_u (f64.nearest (f64.min (f64.const 255) (f64.max (f64.const 0) (local.get $b))))))
   (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $xloop)
  ))
  (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $yloop)
 ))
))
